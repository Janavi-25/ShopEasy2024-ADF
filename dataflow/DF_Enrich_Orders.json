{
	"name": "DF_Enrich_Orders",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_SQL_Orders",
						"type": "DatasetReference"
					},
					"name": "RawSource"
				},
				{
					"dataset": {
						"referenceName": "DS_SQL_dimCustomer",
						"type": "DatasetReference"
					},
					"name": "Customer"
				},
				{
					"dataset": {
						"referenceName": "DS_SQL_dimProduct",
						"type": "DatasetReference"
					},
					"name": "ProductSource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_SQL_Orders",
						"type": "DatasetReference"
					},
					"name": "FinalDestination"
				}
			],
			"transformations": [
				{
					"name": "orderswithcustomers"
				},
				{
					"name": "OrderEnrich"
				},
				{
					"name": "Profitcolumn"
				},
				{
					"name": "Finalenrich"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Orderid as string,",
				"          CustomerId as string,",
				"          ProductId as string,",
				"          Customername as string,",
				"          Productname as string,",
				"          Category as string,",
				"          Orderdate as date,",
				"          Ordermonth as integer,",
				"          OrderYear as integer,",
				"          Quantity as integer,",
				"          Unitprice as decimal(10,2),",
				"          Discountpct as decimal(10,2),",
				"          DiscuntAmount as decimal(10,2),",
				"          GrossRevenue as decimal(10,2),",
				"          Shippingcost as decimal(10,2),",
				"          NetRevenue as decimal(10,2),",
				"          CostofGoods as decimal(10,2),",
				"          GrossProfit as decimal(10,2),",
				"          Paymentmethod as string,",
				"          Orderstatus as string,",
				"          Isdelivered as boolean,",
				"          Region as string,",
				"          LoadAt as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> RawSource",
				"source(output(",
				"          CustomerId as string,",
				"          FullName as string,",
				"          Email as string,",
				"          City as string,",
				"          State as string,",
				"          Country as string,",
				"          CustomerSegment as string,",
				"          JoinDate as date,",
				"          LoadAt as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Customer",
				"source(output(",
				"          ProductId as string,",
				"          ProductName as string,",
				"          Category as string,",
				"          Subcategory as string,",
				"          Brand as string,",
				"          UnitPrice as decimal(10,2),",
				"          CostPrice as decimal(10,2),",
				"          IsActive as boolean,",
				"          Supplier as string,",
				"          LoadAt as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> ProductSource",
				"RawSource, Customer join(RawSource@CustomerId == Customer@CustomerId,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> orderswithcustomers",
				"orderswithcustomers, ProductSource join(RawSource@ProductId == ProductSource@ProductId,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> OrderEnrich",
				"OrderEnrich derive(CostOfGoods = Quantity * CostPrice,",
				"          GrossProfit = NetRevenue - (Quantity*CostPrice),",
				"          ProfitMarginPct = NetRevenue - (Quantity * CostPrice) / iif(NetRevenue == toDecimal(0), toDecimal(1), NetRevenue) * toDecimal(100)) ~> Profitcolumn",
				"Profitcolumn select(mapColumn(",
				"          Orderid,",
				"          Customername = FullName,",
				"          Productname = ProductSource@ProductName,",
				"          Category = ProductSource@Category,",
				"          Orderdate,",
				"          Ordermonth,",
				"          OrderYear,",
				"          Quantity,",
				"          Unitprice = RawSource@Unitprice,",
				"          Discountpct,",
				"          DiscuntAmount,",
				"          GrossRevenue,",
				"          Shippingcost,",
				"          NetRevenue,",
				"          CostofGoods = Profitcolumn@CostOfGoods,",
				"          GrossProfit,",
				"          Paymentmethod,",
				"          Orderstatus,",
				"          Isdelivered,",
				"          Region,",
				"          CustomerId = Customer@CustomerId,",
				"          FullName,",
				"          Email,",
				"          City,",
				"          State,",
				"          Country,",
				"          CustomerSegment,",
				"          JoinDate,",
				"          ProductId = ProductSource@ProductId,",
				"          ProductName = ProductSource@ProductName,",
				"          Category = ProductSource@Category,",
				"          Subcategory,",
				"          Brand,",
				"          UnitPrice = ProductSource@UnitPrice,",
				"          CostPrice,",
				"          IsActive,",
				"          Supplier,",
				"          CostOfGoods = Profitcolumn@CostOfGoods,",
				"          ProfitMarginPct",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Finalenrich",
				"Finalenrich sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Orderid as string,",
				"          CustomerId as string,",
				"          ProductId as string,",
				"          Customername as string,",
				"          Productname as string,",
				"          Category as string,",
				"          Orderdate as date,",
				"          Ordermonth as integer,",
				"          OrderYear as integer,",
				"          Quantity as integer,",
				"          Unitprice as decimal(10,2),",
				"          Discountpct as decimal(10,2),",
				"          DiscuntAmount as decimal(10,2),",
				"          GrossRevenue as decimal(10,2),",
				"          Shippingcost as decimal(10,2),",
				"          NetRevenue as decimal(10,2),",
				"          CostofGoods as decimal(10,2),",
				"          GrossProfit as decimal(10,2),",
				"          Paymentmethod as string,",
				"          Orderstatus as string,",
				"          Isdelivered as boolean,",
				"          Region as string,",
				"          LoadAt as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Orderid,",
				"          CustomerId,",
				"          ProductId,",
				"          Customername,",
				"          Productname = {Finalenrich@Productname},",
				"          Category,",
				"          Orderdate,",
				"          Ordermonth,",
				"          OrderYear,",
				"          Quantity,",
				"          Unitprice = Finalenrich@Unitprice,",
				"          Discountpct,",
				"          DiscuntAmount,",
				"          GrossRevenue,",
				"          Shippingcost,",
				"          NetRevenue,",
				"          CostofGoods = {Finalenrich@CostofGoods},",
				"          GrossProfit,",
				"          Paymentmethod,",
				"          Orderstatus,",
				"          Isdelivered,",
				"          Region",
				"     )) ~> FinalDestination"
			]
		}
	}
}